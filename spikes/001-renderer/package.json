{
  "name": "spike-001-renderer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "M1 spike: render a hard-coded A2UI v0.9 message sequence in a Vite page.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev --port 6006 --exact-port --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@a2ui/react": "0.12.0",
    "@a2ui/web_core": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
